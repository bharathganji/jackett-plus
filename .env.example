TZ=Asia/Kolkata

# ==============================================================================
# OpenVPN Client Configuration (dperson/openvpn-client)
# ==============================================================================
# Free OpenVPN profiles and rotating credentials can be obtained from:
# https://www.vpnbook.com/freevpn/openvpn
#
# Format: "server;username;password"
# Example: "vpnbook.com;vpnbook;your_password_here"
VPN_AUTH=vpnbook.com;vpnbook;your_password_here
VPN_DNS=8.8.8.8,8.8.4.4
VPN_FIREWALL=

# ==============================================================================
# Jackett Core Configuration
# ==============================================================================
# API key found in your Jackett Admin UI (top right corner of http://localhost:9117)
JACKETT_API_KEY=your_jackett_api_key_here

# ==============================================================================
# Network Ingress & Port Configuration (Cloudflare Tunnel Friendly)
# ==============================================================================
# Host IP Binding:
# - Leave empty or set to 0.0.0.0 for access across all network interfaces.
# - Set to 127.0.0.1 for maximum security when using Cloudflare Tunnel,
#   ensuring services are ONLY accessible locally and cannot be probed publicly.
HOST_IP=127.0.0.1

# 1. UI Port (Primary Ingress for Cloudflare Tunnel)
# Points your main tunnel hostname (e.g. search.yourdomain.com) to http://localhost:${UI_PORT}
UI_PORT=3001

# 2. Optional Search Port (Jackett Native Admin UI)
# Set a custom port, or point a dedicated tunnel hostname to http://localhost:${SEARCH_PORT}
SEARCH_PORT=9117

# 3. Optional Backend API Port (Direct FastAPI SSE Stream)
# Set a custom port, or point a dedicated tunnel hostname to http://localhost:${API_PORT}
API_PORT=9889

# 4. Optional FlareSolverr Port (Internal Solver API)
FLARE_PORT=8191

# Frontend Routing (Relative /api proxies through Nginx to FastAPI)
FRONTEND_API_URL=/api
